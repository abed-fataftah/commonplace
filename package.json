{
  "name": "commonplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @commonplace/api",
    "dev:web": "npm run dev -w @commonplace/web",
    "build": "npm run build -w @commonplace/web"
  }
}

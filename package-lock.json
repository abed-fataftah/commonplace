{
  "name": "commonplace",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "commonplace",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22.12.0"
      }
    },
    "apps/api": {
      "name": "@commonplace/api",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@commonplace/web",
      "version": "0.0.0"
    },
    "node_modules/@commonplace/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@commonplace/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@commonplace/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@commonplace/shared",
      "version": "0.0.0"
    }
  }
}
